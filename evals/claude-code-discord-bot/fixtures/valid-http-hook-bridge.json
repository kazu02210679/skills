{
  "version": 1,
  "discord": {
    "guild_id": "123456789012345678",
    "command_channel_ids": ["223456789012345678"],
    "notification_channel_id": "323456789012345678",
    "operator_user_ids": ["423456789012345678"],
    "approver_user_ids": ["523456789012345678"],
    "token_env": "DISCORD_BOT_TOKEN"
  },
  "runtime": {
    "transport": "cli",
    "workspace_root": "/home/me/src",
    "projects": {
      "skills": "/home/me/src/skills",
      "notes": "/home/me/src/notes"
    },
    "permission_mode": "acceptEdits",
    "allowed_tools": ["Read"],
    "max_concurrent_sessions": 1
  },
  "approval": {
    "enabled": true,
    "transport": "http-hook",
    "listen_host": "127.0.0.1",
    "listen_port": 8787,
    "shared_secret_env": "CLAUDE_DISCORD_HOOK_TOKEN",
    "hook_timeout_seconds": 600,
    "timeout_seconds": 300,
    "on_timeout": "deny"
  },
  "notifications": {
    "on_completion": true,
    "on_idle_prompt": false,
    "on_permission_request": true
  }
}
